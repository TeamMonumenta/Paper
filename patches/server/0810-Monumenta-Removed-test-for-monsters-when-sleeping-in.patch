-                            return entitymonster.isPreventingPlayerRest((Player) this);
-                        });
-
-                        if (!list.isEmpty()) {
-                            return Either.left(Player.BedSleepingProblem.NOT_SAFE);
-                        }
-                    }
-
                     return Either.right(Unit.INSTANCE);
                 }
