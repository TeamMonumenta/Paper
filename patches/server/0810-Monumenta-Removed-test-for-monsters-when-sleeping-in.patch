@@ -1265,19 +1265,6 @@ public class ServerPlayer extends Player {
                 if (this.level.isDay()) {
                     return Either.left(Player.BedSleepingProblem.NOT_POSSIBLE_NOW);
                 } else {
-                    if (!this.isCreative()) {
-                        double d0 = 8.0D;
